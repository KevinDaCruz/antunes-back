# Copie ce fichier en .env et adapte les valeurs. .env n'est jamais commité.

# --- Serveur ---
NODE_ENV=development
PORT=4000

# --- MongoDB (Docker local via docker-compose.yml) ---
MONGO_ROOT_USER=antunes
MONGO_ROOT_PASSWORD=change-me
MONGO_URI=mongodb://antunes:change-me@localhost:27018/antunes?authSource=admin

# --- Auth ---
JWT_SECRET=change-me-with-a-long-random-string
JWT_EXPIRES_IN=7d

# --- CORS (origine autorisée du front) ---
CORS_ORIGIN=http://localhost:5173

# --- Front-end (utilisé pour les URLs de redirection Stripe) ---
FRONTEND_URL=http://localhost:5173

# --- Stripe (mode test — dashboard.stripe.com/test/apikeys) ---
STRIPE_SECRET_KEY=
# Récupérée via `stripe listen --forward-to localhost:4000/api/payments/webhook`
STRIPE_WEBHOOK_SECRET=
