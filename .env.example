# Copie ce fichier en .env et adapte les valeurs. .env n'est jamais commité.

# --- Serveur ---
NODE_ENV=development
PORT=4000

# --- MongoDB (Docker local via docker-compose.yml) ---
MONGO_ROOT_USER=antunes
MONGO_ROOT_PASSWORD=change-me
MONGO_URI=mongodb://antunes:change-me@localhost:27018/antunes?authSource=admin

# --- Auth ---
JWT_SECRET=change-me-with-a-long-random-string
JWT_EXPIRES_IN=7d

# --- CORS (origine autorisée du front) ---
CORS_ORIGIN=http://localhost:5173

# --- Stripe (à renseigner quand on branchera le paiement) ---
STRIPE_SECRET_KEY=
